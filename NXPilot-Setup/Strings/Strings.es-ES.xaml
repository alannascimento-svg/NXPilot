<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Textos del instalador en español. Mismas claves en los tres archivos. -->
    <sys:String x:Key="Setup_NexusXdataInstallNxpilot">Nexus Xdata Install — NXPilot</sys:String>
    <sys:String x:Key="Setup_AbrirNxpilot">Abrir NXPilot</sys:String>
    <sys:String x:Key="Setup_Fechar">Cerrar</sys:String>
    <sys:String x:Key="Setup_InteligenciaArtificialAutomaticaE">Inteligencia Artificial automática, no autónoma — usted tiene el control.</sys:String>
    <sys:String x:Key="Setup_OrquestradorDeAgentesDe">Orquestador de agentes de código (Claude Code, Codex) con log de auditoría y decisiones. Instalación en el perfil del usuario — no requiere administrador ni .NET instalado.</sys:String>
    <sys:String x:Key="Setup_1InstalarONxpilot">1 · Instalar NXPilot</sys:String>
    <sys:String x:Key="Setup_Instalar">Instalar</sys:String>
    <sys:String x:Key="Setup_2ClassificadorDeRisco">2 · Clasificador de riesgo ONNX (recomendado)</sys:String>
    <sys:String x:Key="Setup_ModeloAllMinilmL6">Modelo all-MiniLM-L6-v2 (~90 MB) que clasifica cada acción de los agentes en milisegundos, en la CPU — no requiere GPU. Sin él, NXPilot usa solo reglas.</sys:String>
    <sys:String x:Key="Setup_BaixarModelo">Descargar modelo</sys:String>
    <sys:String x:Key="Setup_3AgentesDeCodigo">3 · Agentes de código</sys:String>
    <sys:String x:Key="Setup_ONxpilotCoordenaOs">NXPilot coordina los agentes que usted ya usa, con su propia suscripción. Instale al menos uno.</sys:String>
    <sys:String x:Key="Setup_Copiar">Copiar</sys:String>
    <sys:String x:Key="Setup_RodeOComandoNum">Ejecute el comando en un PowerShell y luego haga clic en Verificar de nuevo. Las instalaciones dentro de WSL también se reconocen.</sys:String>
    <sys:String x:Key="Setup_VerificarDeNovo">Verificar de nuevo</sys:String>
    <sys:String x:Key="Setup_4IaLocalLlama">4 · IA Local LLaMA (opcional)</sys:String>
    <sys:String x:Key="Setup_UsadaSoNasAcoes">Se usa solo en las acciones en que el ONNX tiene dudas (cascada). Es la misma IA Local de NXProject — si ya está instalado, no hay nada que hacer. Para instalarla: NXProject → IA → Administrar IA Local.</sys:String>
    <sys:String x:Key="Setup_AbrirPasta">abrir carpeta</sys:String>
    <sys:String x:Key="Setup_ComoInstalar">Cómo instalar</sys:String>
    <sys:String x:Key="Setup_ModoInterno">Automática (recomendada)</sys:String>
    <sys:String x:Key="Setup_ModoScript">Script oficial</sys:String>
    <sys:String x:Key="Setup_Versao">Versión</sys:String>
    <sys:String x:Key="Setup_NotaAgentes">Automática: en el área del usuario, sin administrador y sin script. Después de instalar, inicie sesión en su cuenta ejecutando claude o codex una vez en una terminal.</sys:String>
    <sys:String x:Key="Setup_ModoInternoTip">Instalación automática en el área del usuario (sin administrador): el Setup descarga desde el sitio oficial, verifica el SHA-256 e instala sin ejecutar scripts — use esta opción si el antivirus bloquea PowerShell.</sys:String>
    <sys:String x:Key="Setup_ModoScriptTip">Ejecuta el instalador oficial (Anthropic / OpenAI) en una ventana de PowerShell. Algunos antivirus lo bloquean — en ese caso use la Automática.</sys:String>
    <sys:String x:Key="Setup_CopiarTip">Copia el comando oficial para instalar manualmente (péguelo en PowerShell).</sys:String>
    <sys:String x:Key="Setup_InstalarAgenteTip">Instala de la forma elegida arriba. En la Automática: área del usuario, sin administrador.</sys:String>
</ResourceDictionary>

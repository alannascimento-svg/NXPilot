<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Textos do instalador em português. Mesmas chaves nos dois arquivos. -->
    <sys:String x:Key="Setup_NexusXdataInstallNxpilot">Nexus Xdata Install — NXPilot</sys:String>
    <sys:String x:Key="Setup_AbrirNxpilot">Abrir NXPilot</sys:String>
    <sys:String x:Key="Setup_Fechar">Fechar</sys:String>
    <sys:String x:Key="Setup_InteligenciaArtificialAutomaticaE">Inteligência Artificial Automática, e não autônoma — porque você está no controle.</sys:String>
    <sys:String x:Key="Setup_OrquestradorDeAgentesDe">Orquestrador de agentes de código (Claude Code, Codex) com log de auditoria e decisões. Instalação no perfil do usuário — não precisa de administrador nem de .NET instalado.</sys:String>
    <sys:String x:Key="Setup_1InstalarONxpilot">1 · Instalar o NXPilot</sys:String>
    <sys:String x:Key="Setup_Instalar">Instalar</sys:String>
    <sys:String x:Key="Setup_2ClassificadorDeRisco">2 · Classificador de risco ONNX (recomendado)</sys:String>
    <sys:String x:Key="Setup_ModeloAllMinilmL6">Modelo all-MiniLM-L6-v2 (~90 MB) que classifica cada ação dos agentes em milissegundos, na CPU — não precisa de GPU. Sem ele o NXPilot usa só regras.</sys:String>
    <sys:String x:Key="Setup_BaixarModelo">Baixar modelo</sys:String>
    <sys:String x:Key="Setup_3AgentesDeCodigo">3 · Agentes de código</sys:String>
    <sys:String x:Key="Setup_ONxpilotCoordenaOs">O NXPilot coordena os agentes que você já usa, com a sua própria assinatura. Instale pelo menos um.</sys:String>
    <sys:String x:Key="Setup_Copiar">Copiar</sys:String>
    <sys:String x:Key="Setup_RodeOComandoNum">Rode o comando num PowerShell e depois clique em Verificar de novo. Instalações dentro do WSL também são reconhecidas.</sys:String>
    <sys:String x:Key="Setup_VerificarDeNovo">Verificar de novo</sys:String>
    <sys:String x:Key="Setup_4IaLocalLlama">4 · IA Local LLaMA (opcional)</sys:String>
    <sys:String x:Key="Setup_UsadaSoNasAcoes">Usada só nas ações em que o ONNX fica em dúvida (cascata). É a mesma IA Local do NXProject — se ele já está instalado, nada a fazer. Para instalar: NXProject → IA → Gerenciar IA Local.</sys:String>
    <sys:String x:Key="Setup_AbrirPasta">abrir pasta</sys:String>
</ResourceDictionary>

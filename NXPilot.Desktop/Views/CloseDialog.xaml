<Window x:Class="NXPilot.Desktop.Views.CloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="22,18">
        <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="Body" Style="{StaticResource Muted}" FontSize="13" Margin="0,8,0,16"/>

        <Button x:Name="MinimizeButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Padding="12,9" Click="OnMinimize" IsDefault="True"/>
        <TextBlock x:Name="MinimizeHint" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,4,0,12"/>

        <Button x:Name="ExitButton" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Padding="12,9" Click="OnExit"/>
        <TextBlock x:Name="ExitHint" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,4,0,12"/>

        <Button x:Name="CancelButton" Style="{StaticResource SubtleButton}" HorizontalAlignment="Right" IsCancel="True"/>
    </StackPanel>
</Window>

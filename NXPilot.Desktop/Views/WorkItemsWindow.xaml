<Window x:Class="NXPilot.Desktop.Views.WorkItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1000" Height="600" MinWidth="720" MinHeight="380" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="22,18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock x:Name="SubHeading" Style="{StaticResource Muted}" Margin="0,4,0,12"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center" MaxWidth="460"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Style="{StaticResource SubtleButton}" Click="OnRefreshClick"/>
                <Button x:Name="OpenWebButton" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OnOpenWebClick"/>
                <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" Click="OnCreateClick"/>
                <Button x:Name="CloseButton" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="Grid" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnCreateClick">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColId" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn x:Name="ColType" Binding="{Binding Type}" Width="90"/>
                    <DataGridTextColumn x:Name="ColTitle" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn x:Name="ColState" Binding="{Binding State}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="DetailCriteriaLabel" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="DetailCriteria" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>

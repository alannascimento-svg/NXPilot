<Window x:Class="NXPilot.Desktop.Views.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="520" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="20,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ClearButton" Style="{StaticResource SubtleButton}" Padding="10,4" Click="OnClearClick"/>
                <Button x:Name="CloseButton" Style="{StaticResource SubtleButton}" Padding="10,4" Margin="8,0,0,0" IsCancel="True" Click="OnCloseClick"/>
            </StackPanel>
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Style="{StaticResource Muted}" Visibility="Collapsed"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10,8">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Left" Width="4" RadiusX="2" RadiusY="2" Margin="0,0,10,0"
                                           Fill="{Binding ColorKey, Converter={StaticResource Semantic}, ConverterParameter=fg}"/>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>

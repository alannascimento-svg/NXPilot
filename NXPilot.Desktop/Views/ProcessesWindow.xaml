<Window x:Class="NXPilot.Desktop.Views.ProcessesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Proc_Titulo}" Width="980" Height="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13">
    <!-- Processos: sequência de clicar/digitar num app, aprovada inteira; excluir pede nova autorização na hora. -->
    <DockPanel Margin="18,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Proc_Titulo}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{DynamicResource Proc_Sub}"/>
        </StackPanel>
        <TextBox x:Name="RunLog" DockPanel.Dock="Bottom" Height="96" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="12" Margin="0,10,0,0" Padding="6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Processos salvos -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="{DynamicResource Proc_Novo}" Style="{StaticResource SubtleButton}" Click="OnNewClick"/>
                    <Button Content="{DynamicResource Proc_Remover}" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OnRemoveProcessClick"/>
                </StackPanel>
                <ListBox x:Name="ProcessList" SelectionChanged="OnProcessSelected"/>
            </DockPanel>

            <!-- Elementos do app (alvos) -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{DynamicResource Proc_Nome}" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="NameBox" Padding="4,3" Margin="0,2,0,6"/>
                    <TextBlock Text="{DynamicResource Proc_App}" Style="{StaticResource Muted}"/>
                    <DockPanel Margin="0,2,0,6">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Proc_Elementos}" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OnLoadElementsClick"/>
                        <ComboBox x:Name="AppsBox" Padding="6,3"/>
                    </DockPanel>
                    <TextBox x:Name="FilterBox" Padding="4,3" Margin="0,0,0,4" TextChanged="OnFilterChanged" ToolTip="{DynamicResource Proc_Filtrar}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <WrapPanel>
                        <Button Content="{DynamicResource Proc_AddClicar}" Style="{StaticResource SubtleButton}" Margin="0,0,6,6" Click="OnAddClickClick"/>
                        <Button Content="{DynamicResource Proc_AddDigitar}" Style="{StaticResource SubtleButton}" Margin="0,0,6,6" Click="OnAddTypeClick"/>
                        <TextBox x:Name="TypeTextBox" Width="150" Padding="4,3" Margin="0,0,6,6" ToolTip="{DynamicResource Proc_TextoDigitar}"/>
                    </WrapPanel>
                    <WrapPanel>
                        <ComboBox x:Name="KeyBox" Width="90" Padding="4,2" Margin="0,0,6,6"/>
                        <Button Content="{DynamicResource Proc_AddTecla}" Style="{StaticResource SubtleButton}" Margin="0,0,12,6" Click="OnAddKeyClick"/>
                        <TextBox x:Name="WaitBox" Width="40" Padding="4,3" Margin="0,0,6,6" Text="2"/>
                        <Button Content="{DynamicResource Proc_AddEsperar}" Style="{StaticResource SubtleButton}" Margin="0,0,6,6" Click="OnAddWaitClick"/>
                    </WrapPanel>
                </StackPanel>
                <ListBox x:Name="ElementsList" FontSize="12"/>
            </DockPanel>

            <!-- Passos do processo -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" x:Name="ApprovalText" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="↑" Style="{StaticResource SubtleButton}" Click="OnUpClick"/>
                        <Button Content="↓" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OnDownClick"/>
                        <Button Content="{DynamicResource Proc_RemoverPasso}" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OnRemoveStepClick"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Proc_Salvar}" Style="{StaticResource SubtleButton}" Click="OnSaveClick"/>
                        <Button Content="{DynamicResource Proc_Aprovar}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Click="OnApproveClick"/>
                        <Button x:Name="RunButton" Content="{DynamicResource Proc_Executar}" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Click="OnRunClick"/>
                        <Button x:Name="StopButton" Content="{DynamicResource Proc_Parar}" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" IsEnabled="False" Click="OnStopClick"/>
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="StepsList" FontSize="12"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>NXPilot</AssemblyTitle>
    <!-- O projeto continua NXPilot; só o executável se chama NxPilot.exe. -->
    <AssemblyName>NxPilot</AssemblyName>
    <RootNamespace>NXPilot.Desktop</RootNamespace>
    <!-- Main próprio (Program.cs): desvia para o modo hook do agente antes de iniciar o WPF. -->
    <StartupObject>NXPilot.Desktop.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NXPilot.Core\NXPilot.Core.csproj" />
    <!-- Janelas do Windows (FlaUI, MIT): extensões "Power BI Desktop" e "Automatizar janelas do Windows". -->
    <ProjectReference Include="..\NXPilot.WindowsUi\NXPilot.WindowsUi.csproj" />
  </ItemGroup>

</Project>
